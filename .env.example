# Database (Supabase Postgres)
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set this when a reverse proxy gives Next.js an internal request URL.
# Example: https://your-preview-host.example.com
AUTH_REDIRECT_ORIGIN=

# AI Problem Generation (OpenAI GPT-4o)
OPENAI_API_KEY=sk-...

# Solve feature (lib/generate-solution.ts, app/api/solve/route.ts)
# Each Solve request makes two OpenAI calls at temperature 0: a plain-text
# physics call, then a formatting call that turns the verified working into
# the Hawking JSON. Both calls use the same model.
# Model for typed text and PDF problems. Default: gpt-4.1
OPENAI_SOLVE_MODEL=
# Model for photographed problems. Default: gpt-4.1-mini
OPENAI_SOLVE_IMAGE_MODEL=
# Wall-clock budget for one Solve response, in milliseconds. Default: 26000,
# which fits a reverse proxy that cuts requests off at 30 s. Two sequential
# model calls often need longer, so raise this (for example 60000) on hosts
# that allow it. Clamped to 10000..85000.
SOLVE_RESPONSE_BUDGET_MS=

# Admin Access Control
# Comma-separated list of admin emails. These accounts can open the admin
# dashboard and create/manage problems. Fail-closed: if this is empty, NO ONE
# has admin access (students will not see the Dashboard button and cannot reach
# admin routes). Add the Google email(s) you sign in with.
ADMIN_EMAILS=you@example.com
